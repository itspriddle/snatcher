# Dracula, with Alucard, Dracula's own official light arrangement, as its
# light variant. https://draculatheme.com

[dark]
text      = #f8f8f2
muted     = #6272a4
accent    = #bd93f9
loud      = #ff5555
cursor_bg = #44475a
cursor_fg = #f8f8f2
border    = #6272a4
status_bg = #44475a
status_fg = #f8f8f2
warn      = #ffb86c

icon_all         = #f8f8f2
icon_downloading = #8be9fd
icon_completed   = #50fa7b
icon_active      = #bd93f9
icon_inactive    = #f8f8f2
icon_stopped     = #6272a4
icon_error       = #ff5555
icon_waiting     = #f1fa8c

[light]
text      = #1f1f1f
muted     = #6c664b
accent    = #644ac9
loud      = #cb3a2a
cursor_bg = #cfcfde
cursor_fg = #1f1f1f
border    = #6c664b
status_bg = #cfcfde
status_fg = #1f1f1f
warn      = #a34d14

icon_all         = #1f1f1f
icon_downloading = #036a96
icon_completed   = #14710a
icon_active      = #644ac9
icon_inactive    = #1f1f1f
icon_stopped     = #6c664b
icon_error       = #cb3a2a
icon_waiting     = #846e15

# On a 16-color terminal running the Dracula scheme, whose blue is the purple.
[ansi]
text      = default
muted     = bright-black
accent    = blue
loud      = red
cursor_bg = bright-black
cursor_fg = bright-white
border    = bright-black
status_bg = black
status_fg = white
warn      = yellow

icon_all         = default
icon_downloading = cyan
icon_completed   = green
icon_active      = blue
icon_inactive    = default
icon_stopped     = bright-black
icon_error       = red
icon_waiting     = yellow
