# Nord. The light variant follows Nord's own guidance for bright interfaces:
# Polar Night for text, Snow Storm for surfaces. https://www.nordtheme.com

[dark]
text      = #d8dee9
muted     = #4c566a
accent    = #88c0d0
loud      = #bf616a
cursor_bg = #434c5e
cursor_fg = #eceff4
border    = #4c566a
status_bg = #3b4252
status_fg = #d8dee9
warn      = #ebcb8b

[light]
text      = #2e3440
muted     = #4c566a
accent    = #5e81ac
loud      = #bf616a
cursor_bg = #d8dee9
cursor_fg = #2e3440
border    = #4c566a
status_bg = #e5e9f0
status_fg = #2e3440
warn      = #d08770

# On a 16-color terminal running the Nord scheme.
[ansi]
text      = default
muted     = bright-black
accent    = cyan
loud      = red
cursor_bg = bright-black
cursor_fg = bright-white
border    = bright-black
status_bg = black
status_fg = white
warn      = yellow
